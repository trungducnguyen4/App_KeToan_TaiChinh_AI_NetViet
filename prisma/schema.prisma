generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PaymentChannel {
  cash
  bank
}

enum CounterpartyType {
  customer
  supplier
  employee
  internal
  other
}

enum MatchingStatus {
  unmatched
  partial
  matched
}

model Organization {
  id                      String                    @id @default(uuid()) @db.Char(36)
  code                    String                    @unique(map: "uq_organizations_code") @db.VarChar(64)
  name                    String                    @db.VarChar(255)
  taxCode                 String?                   @map("tax_code") @db.VarChar(32)
  baseCurrency            String                    @default("VND") @map("base_currency") @db.VarChar(8)
  timezone                String                    @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  status                  String                    @db.VarChar(20)
  createdAt               DateTime                  @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  accounts                Account[]
  aiJobs                  AiJob[]
  approval_flows          approval_flows[]
  approval_instances      ApprovalInstance[]
  attachment_files        AttachmentFile[]
  auditEvents             AuditEvent[]
  bank_accounts           bank_accounts[]
  bankStatements          BankStatement[]
  cashBooks               CashBook[]
  contracts               contracts[]
  cost_items              cost_items[]
  customers               Customer[]
  depreciation_runs       depreciation_runs[]
  employees               employees[]
  fixed_assets            fixed_assets[]
  inventory_balances      inventory_balances[]
  inventory_documents     inventory_documents[]
  item_categories         item_categories[]
  items                   items[]
  journal_entries         journal_entries[]
  ledger_balances         ledger_balances[]
  materialized_metrics    materialized_metrics[]
  opening_balance_batches opening_balance_batches[]
  prepaid_expenses        prepaid_expenses[]
  report_snapshots        report_snapshots[]
  roles                   Role[]
  sources                 SourceSystem[]
  suppliers               Supplier[]
  syncMappings            SyncMapping[]
  syncRuns                SyncRun[]
  units_of_measure        units_of_measure[]
  users                   User[]
  vouchers                Voucher[]
  warehouses              warehouses[]

  @@map("organizations")
}

model User {
  id                                  String                    @id @default(uuid()) @db.Char(36)
  organizationId                      String                    @map("organization_id") @db.Char(36)
  email                               String?                   @db.VarChar(255)
  username                            String                    @db.VarChar(120)
  fullName                            String                    @map("full_name") @db.VarChar(255)
  passwordHash                        String?                   @map("password_hash") @db.VarChar(255)
  status                              String                    @db.VarChar(20)
  lastLoginAt                         DateTime?                 @map("last_login_at")
  createdAt                           DateTime                  @map("created_at")
  updatedAt                           DateTime                  @updatedAt @map("updated_at")
  ai_jobs                             AiJob[]
  approval_actions                    ApprovalAction[]
  approval_flow_steps                 approval_flow_steps[]
  attachment_files                    AttachmentFile[]
  audit_events                        AuditEvent[]
  bank_reconciliation_matches         BankReconciliationMatch[]
  depreciation_runs                   depreciation_runs[]
  journal_entries                     journal_entries[]
  report_snapshots                    report_snapshots[]
  roles                               UserRole[]
  organization                        Organization              @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_users_org")
  vouchers_vouchers_created_byTousers Voucher[]                 @relation("vouchers_created_byTousers")
  vouchers_vouchers_updated_byTousers Voucher[]                 @relation("vouchers_updated_byTousers")

  @@unique([organizationId, email], map: "uq_users_org_email")
  @@unique([organizationId, username], map: "uq_users_org_username")
  @@index([organizationId], map: "idx_users_org")
  @@map("users")
}

model Role {
  id                  String                @id @default(uuid()) @db.Char(36)
  organizationId      String                @map("organization_id") @db.Char(36)
  code                String                @db.VarChar(64)
  name                String                @db.VarChar(255)
  isSystem            Boolean               @default(false) @map("is_system")
  createdAt           DateTime              @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  approval_flow_steps approval_flow_steps[]
  organization        Organization          @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_roles_org")
  users               UserRole[]

  @@unique([organizationId, code], map: "uq_roles_org_code")
  @@index([organizationId], map: "idx_roles_org")
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  roleId    String   @map("role_id") @db.Char(36)
  createdAt DateTime @map("created_at")
  role      Role     @relation(fields: [roleId], references: [id], onUpdate: Restrict, map: "fk_user_roles_role")
  user      User     @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "fk_user_roles_user")

  @@unique([userId, roleId], map: "uq_user_roles_user_role")
  @@index([roleId], map: "idx_user_roles_role")
  @@index([userId], map: "idx_user_roles_user")
  @@map("user_roles")
}

model SourceSystem {
  id                      String                    @id @default(uuid()) @db.Char(36)
  organizationId          String                    @map("organization_id") @db.Char(36)
  code                    String                    @db.VarChar(64)
  name                    String                    @db.VarChar(255)
  sourceType              String                    @map("source_type") @db.VarChar(40)
  baseUrl                 String?                   @map("base_url") @db.VarChar(512)
  authType                String?                   @map("auth_type") @db.VarChar(40)
  status                  String                    @db.VarChar(20)
  lastSyncedAt            DateTime?                 @map("last_synced_at")
  createdAt               DateTime                  @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  accounts                Account[]
  bank_accounts           bank_accounts[]
  contracts               contracts[]
  cost_items              cost_items[]
  customers               Customer[]
  employees               employees[]
  fixed_assets            fixed_assets[]
  items                   items[]
  opening_balance_batches opening_balance_batches[]
  organization            Organization              @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_source_systems_org")
  suppliers               Supplier[]
  syncMappings            SyncMapping[]
  syncRuns                SyncRun[]
  vouchers                Voucher[]
  warehouses              warehouses[]

  @@unique([organizationId, code], map: "uq_source_systems_org_code")
  @@index([organizationId], map: "idx_source_systems_org")
  @@map("source_systems")
}

model SyncRun {
  id              String           @id @default(uuid()) @db.Char(36)
  organizationId  String           @map("organization_id") @db.Char(36)
  sourceSystemId  String           @map("source_system_id") @db.Char(36)
  entityName      String           @map("entity_name") @db.VarChar(120)
  mode            String           @db.VarChar(20)
  status          String           @db.VarChar(20)
  startedAt       DateTime         @map("started_at")
  endedAt         DateTime?        @map("ended_at")
  recordsRead     Int              @default(0) @map("records_read")
  recordsInserted Int              @default(0) @map("records_inserted")
  recordsUpdated  Int              @default(0) @map("records_updated")
  recordsSkipped  Int              @default(0) @map("records_skipped")
  recordsFailed   Int              @default(0) @map("records_failed")
  errorMessage    String?          @map("error_message") @db.Text
  createdAt       DateTime         @map("created_at")
  mappings        SyncMapping[]
  rawPayloads     SyncRawPayload[]
  organization    Organization     @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_sync_runs_org")
  sourceSystem    SourceSystem     @relation(fields: [sourceSystemId], references: [id], onUpdate: Restrict, map: "fk_sync_runs_source")

  @@index([organizationId, sourceSystemId, entityName, startedAt], map: "idx_sync_runs_org_source_entity_started")
  @@index([sourceSystemId], map: "idx_sync_runs_source")
  @@map("sync_runs")
}

model SyncMapping {
  id              String       @id @default(uuid()) @db.Char(36)
  organizationId  String       @map("organization_id") @db.Char(36)
  sourceSystemId  String       @map("source_system_id") @db.Char(36)
  entityName      String       @map("entity_name") @db.VarChar(120)
  sourceRecordId  String       @map("source_record_id") @db.VarChar(128)
  localTableName  String       @map("local_table_name") @db.VarChar(128)
  localRecordId   String       @map("local_record_id") @db.Char(36)
  sourceUpdatedAt DateTime?    @map("source_updated_at")
  sourceChecksum  String?      @map("source_checksum") @db.VarChar(128)
  syncStatus      String       @map("sync_status") @db.VarChar(20)
  lastSyncRunId   String?      @map("last_sync_run_id") @db.Char(36)
  createdAt       DateTime     @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  lastSyncRun     SyncRun?     @relation(fields: [lastSyncRunId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sync_mappings_last_run")
  organization    Organization @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_sync_mappings_org")
  sourceSystem    SourceSystem @relation(fields: [sourceSystemId], references: [id], onUpdate: Restrict, map: "fk_sync_mappings_source")

  @@unique([sourceSystemId, entityName, sourceRecordId], map: "uq_sync_mappings_source")
  @@index([lastSyncRunId], map: "fk_sync_mappings_last_run")
  @@index([localTableName, localRecordId], map: "idx_sync_mappings_local")
  @@index([organizationId], map: "idx_sync_mappings_org")
  @@map("sync_mappings")
}

model SyncRawPayload {
  id             String   @id @default(uuid()) @db.Char(36)
  syncRunId      String   @map("sync_run_id") @db.Char(36)
  entityName     String   @map("entity_name") @db.VarChar(120)
  sourceRecordId String   @map("source_record_id") @db.VarChar(128)
  payload        String   @db.LongText
  payloadHash    String   @map("payload_hash") @db.VarChar(128)
  createdAt      DateTime @map("created_at")
  syncRun        SyncRun  @relation(fields: [syncRunId], references: [id], onUpdate: Restrict, map: "fk_sync_raw_payloads_run")

  @@index([payloadHash], map: "idx_sync_raw_payloads_hash")
  @@index([syncRunId, entityName], map: "idx_sync_raw_payloads_run_entity")
  @@map("sync_raw_payloads")
}

model Account {
  id                               String                             @id @default(uuid()) @db.Char(36)
  organizationId                   String                             @map("organization_id") @db.Char(36)
  code                             String                             @db.VarChar(64)
  name                             String                             @db.VarChar(255)
  parentId                         String?                            @map("parent_id") @db.Char(36)
  accountGroup                     String                             @map("account_group") @db.VarChar(30)
  normalBalance                    String                             @map("normal_balance") @db.VarChar(10)
  level                            Int
  isPostable                       Boolean                            @default(true) @map("is_postable")
  isActive                         Boolean                            @default(true) @map("is_active")
  allowsCounterparty               Boolean                            @default(false) @map("allows_counterparty")
  allowsContract                   Boolean                            @default(false) @map("allows_contract")
  allowsItem                       Boolean                            @default(false) @map("allows_item")
  allowsWarehouse                  Boolean                            @default(false) @map("allows_warehouse")
  allowsEmployee                   Boolean                            @default(false) @map("allows_employee")
  effective_from                   DateTime?                          @db.Date
  effective_to                     DateTime?                          @db.Date
  source_system_id                 String?                            @db.Char(36)
  source_record_id                 String?                            @db.VarChar(128)
  source_updated_at                DateTime?
  source_checksum                  String?                            @db.VarChar(128)
  createdAt                        DateTime                           @map("created_at")
  updatedAt                        DateTime                           @updatedAt @map("updated_at")
  organization                     Organization                       @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_accounts_org")
  parent                           Account?                           @relation("AccountHierarchy", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounts_parent")
  children                         Account[]                          @relation("AccountHierarchy")
  source_systems                   SourceSystem?                      @relation(fields: [source_system_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounts_source")
  journal_entry_lines              journal_entry_lines[]
  ledger_balances                  ledger_balances[]
  opening_balance_account_lines    opening_balance_account_lines[]
  opening_balance_payable_lines    opening_balance_payable_lines[]
  opening_balance_receivable_lines opening_balance_receivable_lines[]
  voucher_lines                    VoucherLine[]

  @@unique([organizationId, code], map: "uq_accounts_org_code")
  @@index([parentId], map: "fk_accounts_parent")
  @@index([organizationId, isActive], map: "idx_accounts_active")
  @@index([organizationId, accountGroup], map: "idx_accounts_group")
  @@index([organizationId, parentId], map: "idx_accounts_org_parent")
  @@index([source_system_id, source_record_id], map: "idx_accounts_source")
  @@map("accounts")
}

model Customer {
  id                               String                             @id @default(uuid()) @db.Char(36)
  organizationId                   String                             @map("organization_id") @db.Char(36)
  code                             String                             @db.VarChar(64)
  name                             String                             @db.VarChar(255)
  taxCode                          String?                            @map("tax_code") @db.VarChar(32)
  short_name                       String?                            @db.VarChar(255)
  phone                            String?                            @db.VarChar(40)
  email                            String?                            @db.VarChar(255)
  address                          String?                            @db.VarChar(512)
  status                           String                             @db.VarChar(20)
  source_system_id                 String?                            @db.Char(36)
  source_record_id                 String?                            @db.VarChar(128)
  source_updated_at                DateTime?
  source_checksum                  String?                            @db.VarChar(128)
  createdAt                        DateTime                           @map("created_at")
  updatedAt                        DateTime                           @updatedAt @map("updated_at")
  contracts                        contracts[]
  organization                     Organization                       @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_customers_org")
  source_systems                   SourceSystem?                      @relation(fields: [source_system_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_customers_source")
  journal_entry_lines              journal_entry_lines[]
  ledger_balances                  ledger_balances[]
  opening_balance_account_lines    opening_balance_account_lines[]
  opening_balance_receivable_lines opening_balance_receivable_lines[]
  voucher_lines                    VoucherLine[]

  @@unique([organizationId, code], map: "uq_customers_org_code")
  @@index([source_system_id, source_record_id], map: "idx_customers_source")
  @@map("customers")
}

model Supplier {
  id                            String                          @id @default(uuid()) @db.Char(36)
  organizationId                String                          @map("organization_id") @db.Char(36)
  code                          String                          @db.VarChar(64)
  name                          String                          @db.VarChar(255)
  taxCode                       String?                         @map("tax_code") @db.VarChar(32)
  short_name                    String?                         @db.VarChar(255)
  phone                         String?                         @db.VarChar(40)
  email                         String?                         @db.VarChar(255)
  address                       String?                         @db.VarChar(512)
  status                        String                          @db.VarChar(20)
  source_system_id              String?                         @db.Char(36)
  source_record_id              String?                         @db.VarChar(128)
  source_updated_at             DateTime?
  source_checksum               String?                         @db.VarChar(128)
  createdAt                     DateTime                        @map("created_at")
  updatedAt                     DateTime                        @updatedAt @map("updated_at")
  contracts                     contracts[]
  journal_entry_lines           journal_entry_lines[]
  ledger_balances               ledger_balances[]
  opening_balance_account_lines opening_balance_account_lines[]
  opening_balance_payable_lines opening_balance_payable_lines[]
  prepaid_expenses              prepaid_expenses[]
  organization                  Organization                    @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_suppliers_org")
  source_systems                SourceSystem?                   @relation(fields: [source_system_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_suppliers_source")
  voucher_lines                 VoucherLine[]

  @@unique([organizationId, code], map: "uq_suppliers_org_code")
  @@index([source_system_id, source_record_id], map: "idx_suppliers_source")
  @@map("suppliers")
}

model CashBook {
  id             String       @id @default(uuid()) @db.Char(36)
  organizationId String       @map("organization_id") @db.Char(36)
  code           String       @db.VarChar(64)
  name           String       @db.VarChar(255)
  currency_code  String       @default("VND") @db.VarChar(8)
  status         String       @db.VarChar(20)
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_cash_books_org")
  vouchers       Voucher[]

  @@unique([organizationId, code], map: "uq_cash_books_org_code")
  @@map("cash_books")
}

model Voucher {
  id                               String                    @id @default(uuid()) @db.Char(36)
  organizationId                   String                    @map("organization_id") @db.Char(36)
  voucherType                      String                    @map("voucher_type") @db.VarChar(40)
  voucherNo                        String                    @map("voucher_no") @db.VarChar(64)
  voucherDate                      DateTime                  @map("voucher_date") @db.Date
  posting_date                     DateTime?                 @db.Date
  currencyCode                     String                    @default("VND") @map("currency_code") @db.VarChar(8)
  exchange_rate                    Decimal                   @default(1.000000) @db.Decimal(18, 6)
  status                           String                    @db.VarChar(20)
  approval_status                  String                    @db.VarChar(20)
  source_system_id                 String?                   @db.Char(36)
  source_record_id                 String?                   @db.VarChar(128)
  source_updated_at                DateTime?
  source_checksum                  String?                   @db.VarChar(128)
  description                      String?                   @db.VarChar(1000)
  payment_channel                  PaymentChannel?
  cash_book_id                     String?                   @db.Char(36)
  bank_account_id                  String?                   @db.Char(36)
  counterparty_type                CounterpartyType?
  reference_invoice_no             String?                   @db.VarChar(128)
  matched_amount                   Decimal                   @default(0.00) @db.Decimal(18, 2)
  reconciliation_status            MatchingStatus            @default(unmatched)
  total_debit                      Decimal                   @default(0.00) @db.Decimal(18, 2)
  total_credit                     Decimal                   @default(0.00) @db.Decimal(18, 2)
  createdBy                        String?                   @map("created_by") @db.Char(36)
  updated_by                       String?                   @db.Char(36)
  createdAt                        DateTime                  @map("created_at")
  updatedAt                        DateTime                  @updatedAt @map("updated_at")
  cashBook                         CashBook?                 @relation(fields: [cash_book_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vouchers_cash_book")
  bank_accounts                    bank_accounts?            @relation(fields: [bank_account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vouchers_bank_account")
  reconciliationMatches            BankReconciliationMatch[]
  inventory_documents              inventory_documents[]
  lines                            VoucherLine[]
  users_vouchers_created_byTousers User?                     @relation("vouchers_created_byTousers", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vouchers_created_by")
  organization                     Organization              @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_vouchers_org")
  source_systems                   SourceSystem?             @relation(fields: [source_system_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vouchers_source")
  users_vouchers_updated_byTousers User?                     @relation("vouchers_updated_byTousers", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_vouchers_updated_by")

  @@unique([organizationId, voucherType, voucherNo], map: "uq_vouchers_org_type_no")
  @@index([createdBy], map: "fk_vouchers_created_by")
  @@index([updated_by], map: "fk_vouchers_updated_by")
  @@index([organizationId, status, voucherDate], map: "idx_vouchers_org_status_date")
  @@index([organizationId, voucherType, voucherDate], map: "idx_vouchers_org_type_date")
  @@index([organizationId, bank_account_id, voucherDate], map: "idx_vouchers_org_bank_date")
  @@index([organizationId, cash_book_id, voucherDate], map: "idx_vouchers_org_cash_book_date")
  @@index([bank_account_id], map: "fk_vouchers_bank_account")
  @@index([cash_book_id], map: "fk_vouchers_cash_book")
  @@index([source_system_id, source_record_id], map: "idx_vouchers_source")
  @@map("vouchers")
}

model VoucherLine {
  id              String         @id @default(uuid()) @db.Char(36)
  voucherId       String         @map("voucher_id") @db.Char(36)
  lineNo          Int            @map("line_no")
  account_id      String         @db.Char(36)
  customer_id     String?        @db.Char(36)
  supplier_id     String?        @db.Char(36)
  employee_id     String?        @db.Char(36)
  contract_id     String?        @db.Char(36)
  cost_item_id    String?        @db.Char(36)
  warehouse_id    String?        @db.Char(36)
  bank_account_id String?        @db.Char(36)
  item_id         String?        @db.Char(36)
  debit_amount    Decimal        @default(0.00) @db.Decimal(18, 2)
  credit_amount   Decimal        @default(0.00) @db.Decimal(18, 2)
  quantity        Decimal?       @db.Decimal(18, 4)
  unit_price      Decimal?       @db.Decimal(18, 4)
  tax_rate        Decimal?       @db.Decimal(5, 2)
  memo            String?        @db.VarChar(500)
  created_at      DateTime
  accounts        Account        @relation(fields: [account_id], references: [id], onUpdate: Restrict, map: "fk_voucher_lines_account")
  bank_accounts   bank_accounts? @relation(fields: [bank_account_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_voucher_lines_bank_account")
  contracts       contracts?     @relation(fields: [contract_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_voucher_lines_contract")
  cost_items      cost_items?    @relation(fields: [cost_item_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_voucher_lines_cost_item")
  customers       Customer?      @relation(fields: [customer_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_voucher_lines_customer")
  employees       employees?     @relation(fields: [employee_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_voucher_lines_employee")
  items           items?         @relation(fields: [item_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_voucher_lines_item")
  suppliers       Supplier?      @relation(fields: [supplier_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_voucher_lines_supplier")
  voucher         Voucher        @relation(fields: [voucherId], references: [id], onUpdate: Restrict, map: "fk_voucher_lines_voucher")
  warehouses      warehouses?    @relation(fields: [warehouse_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_voucher_lines_warehouse")

  @@unique([voucherId, lineNo], map: "uq_voucher_lines_voucher_line")
  @@index([contract_id], map: "fk_voucher_lines_contract")
  @@index([cost_item_id], map: "fk_voucher_lines_cost_item")
  @@index([employee_id], map: "fk_voucher_lines_employee")
  @@index([item_id], map: "fk_voucher_lines_item")
  @@index([account_id], map: "idx_voucher_lines_account")
  @@index([bank_account_id], map: "idx_voucher_lines_bank_account")
  @@index([customer_id], map: "idx_voucher_lines_customer")
  @@index([supplier_id], map: "idx_voucher_lines_supplier")
  @@index([warehouse_id], map: "idx_voucher_lines_warehouse")
  @@map("voucher_lines")
}

model ApprovalInstance {
  id              String           @id @default(uuid()) @db.Char(36)
  organization_id String           @db.Char(36)
  flow_id         String           @db.Char(36)
  document_type   String           @db.VarChar(40)
  document_id     String           @db.Char(36)
  status          String           @db.VarChar(20)
  current_step_no Int              @default(1)
