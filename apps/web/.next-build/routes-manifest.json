      "page": "/modules/[moduleKey]",
      "regex": "^/modules/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPmoduleKey": "nxtPmoduleKey"
      },
      "namedRegex": "^/modules/(?<nxtPmoduleKey>[^/]+?)(?:/)?$"
    }
  ],
